# Copy this file to .env and fill in only the providers you actually use.
# multi-llm-compare reads keys from process.env at runtime and never writes them anywhere.
#
# Get keys from:
#   OpenAI:      https://platform.openai.com/api-keys
#   Anthropic:   https://console.anthropic.com/settings/keys
#   Google AI:   https://aistudio.google.com/apikey
#   xAI:         https://console.x.ai/

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# XAI_API_KEY=xai-...

# Optional: override default base URLs (use for proxies, Azure OpenAI, self-hosted).
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# XAI_BASE_URL=https://api.x.ai/v1
